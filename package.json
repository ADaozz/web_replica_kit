{
  "name": "web-replica-kit",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "discover": "node scripts/discover.mjs",
    "capture": "node scripts/capture.mjs",
    "serve": "node serve.mjs",
    "test": "node tests/run.mjs",
    "test:e2e": "node --test tests/capture-static.e2e.mjs tests/discover-browser.e2e.mjs tests/icons.test.mjs tests/site-runner.e2e.mjs tests/hidden-components.e2e.mjs",
    "test:scroll": "node --test tests/snapshot-scroll.e2e.mjs",
    "test:css": "node --test tests/css-static.e2e.mjs",
    "test:sites": "node scripts/test-sites.mjs",
    "audit": "node scripts/audit-snapshot.mjs",
    "test:complex-sites": "node scripts/test-sites.mjs --matrix tests/complex-site-matrix.json --wait 3000 --max-nodes 10000",
    "test:hidden": "node --test tests/hidden-components.e2e.mjs"
  },
  "dependencies": {
    "playwright": "^1.55.0"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "pixelmatch": "^8.0.0",
    "pngjs": "^7.0.0"
  }
}
